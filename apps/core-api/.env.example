PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/otkliks

# Секрет для подписи клиентских JWT (openssl rand -base64 32). ОБЯЗАТЕЛЬНО тот же
# самый, что в apps/marketing-site/.env.local: cookie кабинета хранит токен core-api
# напрямую, и marketing-site верифицирует его этим же секретом (см. lib/customer-
# session.ts). Разные значения = клиент логинится, но сессия не проходит проверку.
AUTH_SECRET=

# Ключ Siberi AI — держится только здесь, local-agent его никогда не видит.
SIBERI_API_KEY=

# ЮMoney quickpay — кошелёк и секрет HTTP-уведомлений (yoomoney.ru → Настройки).
# Без них /api/payment/create отвечает 503 "Оплата временно недоступна".
YOOMONEY_WALLET=
YOOMONEY_WEBHOOK_SECRET=

# Транзакционные письма (регистрация, чек об оплате, напоминание об окончании подписки).
# Свой ящик на домене otkliks.ru — НЕ переиспользовать SMTP Siberi (noreply@siberi.online):
# чужой домен отправителя на письмах другого продукта. Без SMTP_HOST письма просто не
# отправляются (лог-предупреждение), остальной код не падает.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Откликс <noreply@otkliks.ru>"

# Ссылка в письмах ("Открыть дашборд" и т.п.) — публичный адрес marketing-site.
SITE_URL=https://otkliks.ru

# Домены, которым разрешено ходить в API (через запятую). marketing-site как BFF ходит
# server-to-server (CORS не нужен), это для случаев прямого браузерного вызова.
CORS_ORIGIN=http://localhost:3000

# Вход через Яндекс и VK. Приложения регистрируются ОТДЕЛЬНО от Siberi:
# адрес возврата привязан к домену, и otkliks.ru в чужое приложение не подставить.
#   Яндекс — oauth.yandex.ru/client/new, Callback URI: https://otkliks.ru/api/auth/yandex/callback
#   VK     — id.vk.com (VK ID), Доверенный redirect URL: https://otkliks.ru/api/auth/vk/callback
# Пока переменные пусты, кнопки на сайте есть, но возвращают понятную ошибку.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=
# Секрет подписи state. Свой, не AUTH_SECRET: смена секрета сессий не должна
# ломать вход через провайдера.
OAUTH_STATE_SECRET=
