# Секрет для подписи admin- и customer-сессий (JWT). Сгенерировать: openssl rand -base64 32
AUTH_SECRET=

# Адрес core-api (auth клиентов, тарифы, дашборд, LLM-прокси для лаунчера)
CORE_API_URL=http://localhost:4000

# Ключ Siberi AI для консультанта на сайте (тот же провайдер, что в automation-core)
SIBERI_API_KEY=

# Только для разового запуска `pnpm seed:owner` — создаёт первый admin-аккаунт (owner)
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Ссылка на установщик лаунчера. Пусто = кабинет пишет «установщик в работе»
# вместо кнопки скачивания в никуда (см. lib/autopilot.ts).
# Установщик больше не собирается — поставка только архивом (см. ниже).
NEXT_PUBLIC_LAUNCHER_ZIP_URL=
